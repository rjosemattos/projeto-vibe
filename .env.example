# Configurações do Prompt Sanitizer (Template de exemplo)
# Copie este arquivo para .env caso queira customizar:
# cp .env.example .env

PROMPT_SANITIZER_DEBUG=False
PROMPT_SANITIZER_HOST=127.0.0.1
PROMPT_SANITIZER_PORT=8000
PROMPT_SANITIZER_MAX_PAYLOAD_BYTES=51200
PROMPT_SANITIZER_MAX_PROMPT_LENGTH=50000
PROMPT_SANITIZER_LOG_LEVEL=INFO

# Criptografia de Regras Confidenciais (Chaves Base64 de 32 bytes / 256 bits)
# Deixe em branco para usar chaves determinísticas seguras em ambiente de desenvolvimento local
PROMPT_SANITIZER_ENCRYPTION_KEY=
PROMPT_SANITIZER_BLIND_INDEX_KEY=


# --- Supabase & PostgreSQL (Vercel Serverless) ---
# Connection String URI do Supabase (porta 6543 para Transaction Pooler)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Restrição de domínio institucional (separe por vírgula se houver mais de um)
ALLOWED_EMAIL_DOMAINS=cesar.school
# Domínio público usado pelo docker-compose/Caddy (TLS automático)
DOMAIN=sanitizer.example.com
# Em produção as duas chaves abaixo são OBRIGATÓRIAS. Gere cada uma com:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# PROMPT_SANITIZER_ENCRYPTION_KEY=
# PROMPT_SANITIZER_BLIND_INDEX_KEY=
# PROMPT_SANITIZER_AUTH_ENABLED=true
# PROMPT_SANITIZER_COOKIE_SECURE=true
# PROMPT_SANITIZER_SESSION_IDLE_MINUTES=30
# PROMPT_SANITIZER_SESSION_MAX_HOURS=12
# PROMPT_SANITIZER_MAX_FAILED_LOGINS=5
# PROMPT_SANITIZER_LOCKOUT_MINUTES=15
