# Configurações do Prompt Sanitizer (Template de exemplo)
# Copie este arquivo para .env caso queira customizar:
# cp .env.example .env

PROMPT_SANITIZER_DEBUG=False
PROMPT_SANITIZER_HOST=127.0.0.1
PROMPT_SANITIZER_PORT=8000
PROMPT_SANITIZER_MAX_PAYLOAD_BYTES=51200
PROMPT_SANITIZER_MAX_PROMPT_LENGTH=50000
PROMPT_SANITIZER_LOG_LEVEL=INFO

# Criptografia de Regras Confidenciais (Chaves Base64 de 32 bytes / 256 bits)
# Deixe em branco para usar chaves determinísticas seguras em ambiente de desenvolvimento local
PROMPT_SANITIZER_ENCRYPTION_KEY=
PROMPT_SANITIZER_BLIND_INDEX_KEY=

